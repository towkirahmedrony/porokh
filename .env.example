# Copy this file to .env.local (git-ignored) and fill in real values.
# Never commit actual environment values.

# Absolute URL of the porokh-backend API. The /api/v1 base path is appended
# automatically when omitted. Required: the app refuses to start without it,
# and the Vite build refuses to run without it.
VITE_API_URL=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

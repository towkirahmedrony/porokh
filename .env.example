# Copy to .env.local and fill in real values. The values below are public and
# ship inside the web bundle and the APK; never place a server secret here.

# API base URL, ending in /api/v1
VITE_API_URL=http://127.0.0.1:5000/api/v1

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OneSignal app id for the Porokh Android app. Public by design: it only
# identifies the app. The REST API key is server-side only (ONESIGNAL_REST_API_KEY
# in porokh-backend) and must never appear in this file.
VITE_ONESIGNAL_APP_ID=

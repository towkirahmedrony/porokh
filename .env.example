# Copy to .env.local and fill in real values. The values below are public and
# ship inside the web bundle and the APK; never place a server secret here.

# API base URL, ending in /api/v1
VITE_API_URL=http://127.0.0.1:5000/api/v1

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Push has no client-side key any more. The Android app reads its Firebase
# configuration from android/app/google-services.json (git-ignored, injected by
# CI) and registers the FCM token it receives with the backend. FCM server
# credentials live only in porokh-backend and must never appear in this file.

<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately invisible. The Android launch splash shows only the brand
    background; the logo the user sees is the one drawn by the in-app splash, so
    the two never appear side by side or jump between sizes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
